APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=api
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# Sanctum SPA (cookie session) auth: origins allowed to authenticate statefully.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000
# SPA origin(s) allowed by CORS (comma-separated). Must match the frontend dev server.
FRONTEND_URL=http://localhost:5173

# Anthropic API. Server-side only — never expose this key to the frontend.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# ⚠️ The reply is stored in messages.content, a MySQL TEXT column capped at
# 65,535 BYTES (~21,800 Japanese characters). User input is validated at
# 10,000 characters, but the AI's reply is not — raising this much above the
# default could overflow the column and surface as a 500.
ANTHROPIC_MAX_TOKENS=4096

# Rate limits for the chat endpoint — the only one that is billed.
# Per-minute stops a runaway loop or a double click; per-day caps the bill.
ANTHROPIC_RATE_LIMIT_PER_MINUTE=1
ANTHROPIC_RATE_LIMIT_PER_DAY=50

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
